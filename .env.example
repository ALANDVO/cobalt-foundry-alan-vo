# Cobalt Foundry — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# LLM (optional, for advisory explanations)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Keycloak OIDC (round 2 milestone)
KEYCLOAK_REALM=
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_CLIENT_ID=cobalt-foundry
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
